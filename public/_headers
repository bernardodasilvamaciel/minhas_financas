# Cloudflare Pages: arquivos com hash no nome podem ficar em cache para sempre;
# o service worker e o manifesto precisam ser revalidados para as atualizações chegarem.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
